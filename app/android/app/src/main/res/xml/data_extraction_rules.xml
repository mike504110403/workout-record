<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的備份規則:allowBackup="false" 在新系統上不足以擋住雲端備份與裝置對裝置遷移,
     這裡把四個 domain 全部排除,App 私有資料(Drift 資料庫、SharedPreferences)不離開本機。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
